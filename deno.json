{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "db:generate": "deno run -A npm:drizzle-kit generate",
    "db:migrate:local": "deno run -A npm:wrangler d1 execute personal-website-v2-db --local --command 'SELECT 1;' && deno run -A npm:drizzle-kit migrate",
    "db:seed": "deno run -A db/seed.ts",
    "db:studio:local": "deno run -A npm:drizzle-kit studio"
  },
  "lint": {
    "rules": {
      "tags": ["fresh", "recommended"]
    }
  },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.8",
    "preact/hooks": "npm:preact@^10.29.8/hooks",
    "@preact/signals": "npm:@preact/signals@^2.11.1",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.3.6",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@fortawesome/fontawesome-svg-core": "npm:@fortawesome/fontawesome-svg-core@^7.3.1",
    "@fortawesome/free-solid-svg-icons": "npm:@fortawesome/free-solid-svg-icons@^7.3.1",
    "@fortawesome/free-brands-svg-icons": "npm:@fortawesome/free-brands-svg-icons@^7.3.1",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "clsx": "npm:clsx@^2.1.1",
    "jose": "npm:jose@^6.2.10",
    "resend": "npm:resend@^6.25.0",
    "marked": "npm:marked@^18.0.11",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-rc.4-5d5b77c",
    "drizzle-orm/": "npm:drizzle-orm@1.0.0-rc.4-5d5b77c/",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-rc.4-5d5b77c",
    "wrangler": "npm:wrangler@4.128.0",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "@std/dotenv/load": "jsr:@std/dotenv@^0.225.8/load",
    "@std/http/cookie": "jsr:@std/http@^1.1.3/cookie",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "zod": "jsr:@zod/zod@^4.5.4",
    "@types/node": "npm:@types/node@^24"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "allowScripts": [
    "npm:esbuild@0.25.12",
    "npm:esbuild@0.25.7",
    "npm:esbuild@0.28.1",
    "npm:esbuild@0.28.2",
    "npm:workerd@1.20260826.1"
  ]
}
