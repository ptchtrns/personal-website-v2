# Password for /login; when unset, login (and the admin dashboard) is disabled entirely
ADMIN_PASSWORD=test

# Signs the session cookie issued on login
JWT_SECRET=your-secret-key-change-in-production

# Used to send contact-form emails via Resend
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that contact-form submissions are sent to
CONTACT_TO_EMAIL=ptchtrns@gmail.com

# How long a session stays valid, in hours
JWT_EXPIRY_HOURS=6

# Public base URL that gallery/media links are built from
PHOTO_BASE_URL=https://ptchtrns.com
